@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>
        It's empty in here, let's add some details by logging into Revolut
    </p>
    <a class="" asp-controller="Revolut" asp-action="auth">
        <div class="inline-flex rounded bg-white p-2 text-black hover:cursor-pointer">
            <div class="content-center">
                <img class="h-5" src="~/img/revolut/Revolut-Logotype-Black.svg">
            </div>
        </div>
    </a>
</div>

<div>
    <canvas id="myChart" class=""></canvas>
</div>

<script src="~/lib/Chart.js/chart.umd.min.js"></script>

<script>

    const ctx = document.getElementById('myChart');
    Chart.defaults.font.family = "'Questrial', sans-serif";
    Chart.defaults.color = "#FFFFFF";

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
            datasets: [{
                label: '# of Votes',
                data: [12, 19, 3, 5, 2, 3],
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
            
        }
    });

</script>
