@{
    Layout = "";
}
@model nbs_smart_wallet.Models.Authentication.Login;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Wallet</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Questrial&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site_tw.css" asp-append-version="true" />
</head>
<body class="font-questrial m-auto max-w-[50em] bg-gray-700 text-lg text-white">
    <header>
        <div class="flex h-[200px] w-full flex-wrap content-center">
            <h1 class="font-inter flex w-full justify-center text-2xl font-bold">SMART WALLET</h1>
        </div>
    </header>
    <main class="flex justify-center">
        @* <div class="flex max-w-fit flex-wrap content-center justify-center rounded bg-white p-2 text-black">
            <a class="" asp-action="Auth" asp-controller="Home" asp-area="">Log in with Revolut</a>
        </div> *@
        <div class="w-full max-w-[20em] rounded bg-gray-800 p-5">
            <form class="grid" asp-action="Login" asp-controller="Home" method="post">
                <div class="row-span-4 grid w-full grid-rows-4 gap-2">
                    <div class="content-center">
                        <input class="flex w-full rounded bg-white pr-[10px] pl-[10px] text-black" asp-for="@Model.Username" type="text" placeholder="Username" />
                    </div>
                    <div class="content-center">
                        <input class="flex w-full rounded bg-white pr-[10px] pl-[10px] text-black" asp-for="@Model.Password" type="password" placeholder="Password" />
                    </div>
                    <div class="flex justify-center">
                        <button class="max-w-fit rounded bg-white p-2 text-black hover:cursor-pointer" type="submit">
                            Log-in
                        </button>
                    </div>
                    <div class="flex content-center justify-center p-2 hover:cursor-pointer">
                        <a class="content-center text-sm text-white underline" asp-action="Register" asp-controller="Home">New to Smart Wallet? Register here.</a>
                    </div>
                </div>
            </form>
        </div>
        
    </main>
</body>
</html>
