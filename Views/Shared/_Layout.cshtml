<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - nbs_smart_wallet</title>
    <script type="importmap"></script>
   
    @* <link rel="stylesheet" href="~/nbs_smart_wallet.styles.css" asp-append-version="true" /> *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Questrial&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site_tw.css" asp-append-version="true" />
    <!-- npx tailwindcss/cli -i .\wwwroot\css\site.css -o .\wwwroot\css\site_tw.css -->
    <!-- bg-[#004A99] bg-[#ED7723] -->
</head>
<body class="font-questrial bg-gray-700 text-lg text-white" >
    <header class="spac relative float-left flex min-h-lvh w-full max-w-1/6 flex-col bg-gray-900">
        <div class="mt-10 mb-10">
            <h1 class="font-inter flex justify-center font-bold">SMART WALLET</h1>
        </div>
        <div class="flex w-full flex-col content-center space-x-4 p-2">
            <a class="" asp-controller="Home" asp-action="Index">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
                        </svg>
                    </div>
                    <div class="">
                        Home
                    </div>
                </div>
            </a>
            @* <a class="" asp-controller="Home" asp-action="Privacy">
                <div class="w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    Privacy
                </div>
            </a> *@
            <a class="" asp-controller="Revolut" asp-action="Accounts">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                    <div class="">
                        Accounts
                    </div>
                </div>
            </a>
            <a class="" asp-controller="Home" asp-action="LogOut">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                        </svg>
                    </div>
                    <div class="">
                        Log-out
                    </div>
                </div>
            </a>
        </div>
        
    </header>
    <div class="relative flex flex-col items-center justify-center">
        <main role="main" class="h-full" style="margin: 0em auto">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
