<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - nbs_smart_wallet</title>
    <script type="importmap"></script>
   
    @* <link rel="stylesheet" href="~/nbs_smart_wallet.styles.css" asp-append-version="true" /> *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Questrial&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site_tw.css" asp-append-version="true" />
    <!-- npx tailwindcss/cli -i .\wwwroot\css\site.css -o .\wwwroot\css\site_tw.css -->
    <!-- bg-[#004A99] bg-[#ED7723] -->
</head>
<body class="font-questrial bg-gray-700 text-lg text-white" >
    <header class="spac relative float-left flex min-h-lvh w-full max-w-1/6 flex-col bg-gray-900">
        <div class="mt-10 mb-10">
            <h1 class="font-inter flex justify-center font-bold">SMART WALLET</h1>
        </div>
        <div class="flex w-full flex-col content-center space-x-4 p-2">
            <a class="w-full" asp-controller="Home" asp-action="Index">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <img class="size-6 invert-[100%]" src="~/img/icons/home.svg">
                    </div>
                    <div class="">
                        Home
                    </div>
                </div>
            </a>
            @* <a class="" asp-controller="Home" asp-action="Privacy">
                <div class="w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    Privacy
                </div>
            </a> *@
            <a class="w-full" asp-controller="Revolut" asp-action="Accounts">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <img class="size-6 invert-[100%]" src="~/img/icons/accounts.svg">
                    </div>
                    <div class="">
                        Accounts
                    </div>
                </div>
            </a>
            <a class="w-full" asp-controller="Report" asp-action="Spendings">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <img class="size-6 invert-[100%]" src="~/img/icons/accounts.svg">
                    </div>
                    <div class="">
                        Spendings
                    </div>
                </div>
            </a>
            <a class="w-full" asp-controller="Home" asp-action="LogOut">
                <div class="inline-flex w-full rounded p-2 hover:cursor-pointer hover:bg-gray-800">
                    <div class="mr-2 content-center">
                        <img class="size-6 invert-[100%]" src="~/img/icons/logout.svg">
                    </div>
                    <div class="">
                        Log-out
                    </div>
                </div>
            </a>
        </div>
        
    </header>
    <div class="relative flex flex-col items-center justify-center">
        
        @RenderBody()

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
