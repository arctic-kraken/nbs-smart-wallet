@{
    var labels = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Spendings.Select(x => x.BookingDate.ToString("dd")).ToList()));
    var data = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Spendings.Select(x => x.Balance).ToList()));

    var budgetLables = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BudgetSpending.Select(x => x.BudgetName).ToList()));
    var budgetData = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BudgetSpending.Select(x => x.BudgetTotal).ToList()));

    var incomeLables = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BudgetIncome.Select(x => x.BudgetName).ToList()));
    var incomeData = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BudgetIncome.Select(x => x.BudgetTotal).ToList()));

    var indicatorLables = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.IndicatorTotals.Select(x => x.IndicatorName).ToList()));
    var indicatorData = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.IndicatorTotals.Select(x => x.TotalSum).ToList()));

    var monthNames = new List<string>();
    for (int i = 1; i <= 12; i++)
        monthNames.Add(new DateTime(2000, i, 1).ToString("MMMM"));
}
@model nbs_smart_wallet.Controllers.ReportController.SpendingsModel;

<main class="w-1/2"> 
     <div class="">
        <div class="">
            <form class="grid" asp-action="Spendings" asp-controller="Report" method="post" asp-route-id="@Model.AccountId">
                <div class="row-span-2 grid w-full grid-rows-2 gap-1">
                    <div class="inline-flex w-full columns-2 justify-center gap-5">
                        <div class="content-center">
                            <select class="rounded bg-gray-800 pt-[5px] pr-[10px] pb-[5px] pl-[10px]" asp-for="@Model.selectedMonth">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    @if (i == Model.selectedMonth)
                                    {
                                        <option selected class="bg-gray-800" value="@i">@monthNames[i - 1]</option>
                                    }
                                    else
                                    {
                                        <option class="bg-gray-800" value="@i">@monthNames[i - 1]</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="content-center">
                            <input class="flex w-[100px] rounded bg-white pr-[10px] pl-[10px] text-black" asp-for="@Model.selectedYear" type="number" placeholder="Year" value="@Model.selectedYear" />
                        </div>
                    </div>
                    <div class="flex justify-center">
                        <button class="max-w-fit rounded bg-white p-2 text-black hover:cursor-pointer" type="submit">
                            Change Viewing Month
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="flex h-full flex-col p-2">
            <div class="flex max-h-1/2 flex-row">
                <div class="w-1/2 content-center p-2">
                    <canvas id="myChart" class="w-full"></canvas>
                </div>
                <div class="w-1/2 content-center p-2">
                    <canvas id="budget_pie" class="w-full justify-self-center"></canvas>
                </div>
            </div>
            <div class="flex max-h-1/2 flex-row">
                <div class="h-1/2 w-1/2 content-center p-2">
                    <canvas id="budget_pie_income" class="w-full justify-self-center"></canvas>
                </div>
                <div class="w-1/2 content-center p-2">
                    <canvas id="creditsdebits" class="w-full"></canvas>
                </div>
            </div>
        </div>
     </div> 
    
</main>


<script src="~/lib/Chart.js/chart.umd.min.js"></script>

<script>

    const ctx = document.getElementById('myChart');
    Chart.defaults.font.family = "'Questrial', sans-serif";
    Chart.defaults.color = "#FFFFFF";
    Chart.defaults.elements.line.fill = false;
    Chart.defaults.elements.line.tension = 0.1;
    Chart.defaults.elements.line.showLine = true;

    const ctx2 = document.getElementById('budget_pie');
    const ctx3 = document.getElementById('budget_pie_income');
    const ctx4 = document.getElementById('creditsdebits');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: @labels,
            datasets: [{
                label: `Balance over the month`,
                data: @data,
                borderColor: "#54B947",
                borderWidth: 2
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    new Chart(ctx2, {
        type: 'pie',
        data: {
            labels: @budgetLables,
            datasets: [{
                label: `Budget Spendings over the month`,
                data: @budgetData,
                borderWidth: 0,
            }]
        },
        
    });

    new Chart(ctx3, {
        type: 'pie',
        data: {
            labels: @incomeLables,
            datasets: [{
                label: `Budget Income over the month`,
                data: @incomeData,
                borderWidth: 0,
            }]
        },

    });

    new Chart(ctx4, {
        type: 'bar',
        data: {
            labels: @indicatorLables,
            datasets: [{
                label: `Credit and Debit Totals over the month`,
                data: @indicatorData,
                backgroundColor: [
                    '#c10007',
                    '#54B947'
                ],
                borderColor: [
                    '#c10007',
                    '#54B947'
                ],
                borderWidth: 2
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

</script>
