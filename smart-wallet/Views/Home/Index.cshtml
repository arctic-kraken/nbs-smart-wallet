@{
    ViewData["Title"] = "Home Page";
}

<main class="h-[50vh] w-full content-center">
    <div class="text-center">
        <h1 class="display-4">Welcome</h1>
        @if (User.IsInRole("Admin"))
        {
            <p>
                It's empty in here, let's add some details by logging into Revolut
            </p>
            <a class="" asp-controller="Revolut" asp-action="auth">
                <div class="inline-flex rounded bg-white p-2 text-black hover:cursor-pointer">
                    <div class="content-center">
                        <img class="h-5" src="~/img/revolut/Revolut-Logotype-Black.svg">
                    </div>
                </div>
            </a>
        } else
        {
            <p>
                It's empty in here, ask your admin to authenticate with Revolut
            </p>
        }

    </div>
</main>
